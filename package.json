{
  "name": "runway-api-playground",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.10.0",
  "workspaces": [
    "packages/runway-shared",
    "packages/runway-mcp"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build --workspace=@runway-playground/shared && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "mcp:install": "npm install --workspace=@runway-playground/mcp",
    "mcp:dev": "npm run dev --workspace=@runway-playground/mcp",
    "mcp:build": "npm run build --workspace=@runway-playground/mcp",
    "build:mcp": "npm run build --workspace=@runway-playground/shared && npm run build --workspace=@runway-playground/mcp",
    "start:mcp": "npm run start --workspace=@runway-playground/mcp",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@runway-playground/shared": "file:packages/runway-shared",
    "@runwayml/sdk": "^4.20.1",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sass": "^1.105.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
