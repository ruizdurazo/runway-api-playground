{
  "name": "@runway-playground/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for Runway media generation (MCP Apps)",
  "main": "dist/index.js",
  "scripts": {
    "build:shared": "tsc -p ../runway-shared/tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run build:shared && npm run typecheck && mcp-use build --no-typecheck",
    "dev": "mcp-use dev",
    "start": "NODE_ENV=production mcp-use start"
  },
  "dependencies": {
    "@runway-playground/shared": "file:../runway-shared",
    "@runwayml/sdk": "^4.20.1",
    "mcp-use": "1.34.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "~4.22.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.1"
  }
}
